<?xml version="1.0" encoding="utf-8"?>
<!-- MyTube: replaces the ripple. Round buttons with a subtle background (TV app), brighter when focused.
     The circle fits the button height so it is never clipped. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:constantSize="true" >
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="@color/lb_control_button_color" />
            <size
                android:height="@dimen/lb_control_button_secondary_diameter"
                android:width="@dimen/lb_control_button_secondary_diameter" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/mytube_control_button_idle" />
            <size
                android:height="@dimen/lb_control_button_secondary_diameter"
                android:width="@dimen/lb_control_button_secondary_diameter" />
        </shape>
    </item>
</selector>
