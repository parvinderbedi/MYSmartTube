<?xml version="1.0" encoding="utf-8"?>
<!-- MyTube category chip: flat shapes only (no shadow/blur). Focused = white, current = light grey, else dark. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/mytube_focus_ring" />
            <corners android:radius="@dimen/mytube_corner_radius" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/mytube_chip_current" />
            <corners android:radius="@dimen/mytube_corner_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/mytube_surface" />
            <corners android:radius="@dimen/mytube_corner_radius" />
        </shape>
    </item>
</selector>
