<resources>
    <!-- Default, same as xhdpi -->
    <!-- 320dpi, Amazon Fire TV Stick -->

    <dimen name="card_width">200dp</dimen>
    <dimen name="card_height">110dp</dimen>
    <!-- text_badge_image_view.xml, default: 12sp -->
