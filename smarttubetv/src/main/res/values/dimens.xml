    <dimen name="shorts_card_width">120dp</dimen>
    <dimen name="shorts_card_height">200dp</dimen>

    <dimen name="tiny_card_width">150dp</dimen>
    <dimen name="tiny_card_height">25dp</dimen>

    <dimen name="channel_card_width">200dp</dimen>
    <dimen name="channel_card_height">30dp</dimen>
    <dimen name="channel_card_text_width">140dp</dimen>

    <dimen name="settings_image_size">70dp</dimen>
    <!-- Old value: 15dp -->
    <dimen name="settings_image_padding">25dp</dimen>
    <!-- Old value: 100dp -->
    <dimen name="settings_card_width">128dp</dimen>
    <dimen name="settings_card_height">100dp</dimen>

    <dimen name="pip_title_max_width">370dp</dimen>
    <dimen name="pip_title_size">24sp</dimen>
    <dimen name="pip_title_date_size">12sp</dimen>
    <dimen name="browse_global_time_size">30sp</dimen>

    <!-- Card view default size -->
    <!--
    <dimen name="lb_basic_card_title_text_size">14sp</dimen>
    <dimen name="lb_basic_card_content_text_size">12sp</dimen>
    -->

    <!-- Search items left margin (except first one). Original value: 70dp -->
    <!-- Problems here: external search dialog won't overlap correctly -->
    <!--<dimen name="lb_search_bar_items_margin_start">20dp</dimen>-->

    <!-- Margin for items from the right side of search field. -->
    <dimen name="search_bar_right_items_margin">20dp</dimen>

    <!-- Margin for items from the right side of search field. -->
    <dimen name="search_bar_global_time_margin">120dp</dimen>

    <!-- Decrease Browse fragment content top padding. -->
    <!-- Old value: 167dp -->
    <dimen name="lb_browse_rows_margin_top">130dp</dimen>

    <!-- Increase this value to hide left strip from Browse fragment (when headers collapsed) -->
    <!-- Old value: 238dp -->
    <dimen name="lb_browse_rows_margin_start">265dp</dimen>

    <!-- Make search bar more compact so more buttons could be added after it. -->
    <dimen name="lb_search_bar_items_width">600dp</dimen>

    <!-- Increase player time text size -->
    <dimen name="lb_playback_controls_time_text_size">18sp</dimen>
    <!-- MyTube player: channel line under the title, readable from the couch -->
    <dimen name="lb_details_description_subtitle_text_size">20sp</dimen>

    <!-- Multiline description in the player -->
    <integer name="lb_details_description_subtitle_max_lines">2</integer>
    <integer name="lb_details_description_title_max_lines">2</integer>

    <!-- App Dialog title tweaks -->
    <dimen name="lb_preference_decor_title_margin_top">10dp</dimen>
    <dimen name="lb_preference_decor_title_margin_bottom">10dp</dimen>
    <dimen name="lb_preference_decor_title_margin_end">24dp</dimen>

    <!-- Make in-app logo smaller -->
    <dimen name="lb_browse_title_icon_height">50dp</dimen>
    <dimen name="lb_browse_title_height">50dp</dimen>

    <!--
    MOD: Make card's corner rounded. More info:
    https://stackoverflow.com/questions/42623677/android-tv-verticalgridfragment-shadow-dimension-and-color
    https://developer.android.com/reference/androidx/leanback/widget/ShadowOverlayHelper
    https://developer.android.com/reference/kotlin/androidx/leanback/widget/ListRowPresenter#arechildroundedcornersenabled
    You can also override ShadowOverlayHelper.Options createShadowOverlayOptions() in
    ListRowPresenter which gives you some ability to change corner radius and focused and unfocused z.
    -->
    <dimen name="lb_rounded_rect_corner_radius">12dp</dimen>

    <!-- MOD: Zoom factor of focused button (SearchOrbView, default: 120%) -->
    <!--<item name="lb_search_orb_focused_zoom" type="fraction">120%</item>-->

    <!-- MOD: Zoom factor of focused sidebar header (default: 1.2) -->
    <!--<item format="float" name="lb_browse_header_select_scale" type="dimen">1.2</item>-->

    <!--
    Space between cards. Origin: 8dp More info:
    https://stackoverflow.com/questions/32402209/set-margins-between-items-on-browsefragment
    -->
    <!--<dimen name="lb_browse_item_horizontal_spacing">15dp</dimen>-->
    <!--<dimen name="lb_browse_item_vertical_spacing">15dp</dimen>-->
    <dimen name="grid_item_horizontal_spacing">15dp</dimen>
    <dimen name="grid_item_vertical_spacing">15dp</dimen>
    <dimen name="grid_horizontal_margin">25dp</dimen>

    <!-- Browse headers spacing. Origin: 21dp -->
    <!--<dimen name="lb_browse_headers_vertical_spacing">10dp</dimen>-->
    <dimen name="browse_headers_vertical_spacing">0dp</dimen>

    <!-- Vine card widget values -->
    <dimen name="lb_basic_card_main_width">140dp</dimen>
    <dimen name="lb_basic_card_main_height">188dp</dimen>
    <dimen name="lb_basic_card_info_height">52dp</dimen>
    <dimen name="lb_basic_card_info_padding">6dp</dimen>
    <dimen name="lb_basic_card_info_badge_size">16dp</dimen>

    <!-- Elements below aren't used in the app -->
    <dimen name="spinner_width">50dp</dimen>
    <dimen name="spinner_height">50dp</dimen>
    <dimen name="detail_thumb_width">274dp</dimen>
    <dimen name="detail_thumb_height">274dp</dimen>
    <dimen name="playback_overlay_width">240dp</dimen>
    <dimen name="playback_overlay_height">240dp</dimen>

    <!-- Default screen margins, per the Android Design guidelines. -->
    <dimen name="activity_horizontal_margin">16dp</dimen>
    <dimen name="activity_vertical_margin">16dp</dimen>

    <!-- Tooltip MOD: extracted private values -->
    <dimen name="tooltip_corner_radius_mod">20dp</dimen>
    <dimen name="tooltip_horizontal_padding_mod">16dp</dimen>
    <dimen name="tooltip_margin_mod">8dp</dimen>
    <dimen name="tooltip_precise_anchor_extra_offset_mod">8dp</dimen>
    <dimen name="tooltip_precise_anchor_threshold_mod">96dp</dimen>
    <dimen name="tooltip_vertical_padding_mod">6.5dp</dimen>
    <dimen name="tooltip_y_offset_non_touch_mod">0dp</dimen>
    <dimen name="tooltip_y_offset_touch_mod">16dp</dimen>

    <!-- MyTube: larger card text, readable from ~3m on a 1080p TV (sp x2 = px at 320dpi) -->
    <dimen name="lb_basic_card_title_text_size">17sp</dimen>
    <dimen name="lb_basic_card_content_text_size">14sp</dimen>
    <!-- Text aligned with thumbnail edge, like the TV home grid -->
    <dimen name="lb_basic_card_info_padding_horizontal">2dp</dimen>
    <dimen name="lb_basic_card_info_padding_top">10dp</dimen>
    <dimen name="lb_basic_card_info_padding_bottom">6dp</dimen>
    <dimen name="lb_basic_card_info_text_margin">4dp</dimen>
    <!-- Sidebar labels -->
    <dimen name="lb_browse_header_text_size">20sp</dimen>
    <!-- Focus ring around thumbnails -->
    <dimen name="mytube_focus_ring_width">3dp</dimen>
    <dimen name="mytube_corner_radius">8dp</dimen>

    <!-- MyTube icon rail: 20dp inset + 32dp icon + 20dp = 72dp. Labels start at 76dp so they are clipped when collapsed. -->
    <dimen name="mytube_rail_width">72dp</dimen>
    <!-- grid padding 8dp + pill padding 12dp = icon at 20dp -->
    <dimen name="mytube_rail_icon_inset">8dp</dimen>
    <dimen name="mytube_rail_pill_padding">12dp</dimen>
    <dimen name="mytube_rail_pill_padding_v">4dp</dimen>
    <dimen name="mytube_rail_icon_size">28dp</dimen>
    <!-- Rail starts near the top (TV app style); all ~12 items fit on a 540dp-tall screen -->
    <dimen name="mytube_rail_top_padding">16dp</dimen>
    <!-- Sidebar items not current/focused: slightly dimmed (default 50%) -->
    <item name="lb_browse_header_unselect_alpha" type="fraction">70%</item>
    <dimen name="mytube_rail_pill_end">16dp</dimen>
    <!-- Full-width pill in the expanded sidebar (headers width 270dp - 8dp grid padding - 16dp end) -->
    <dimen name="mytube_rail_pill_width">246dp</dimen>
    <dimen name="mytube_rail_divider_width">170dp</dimen>
    <!-- divider starts at the label column so it is clipped away in the collapsed rail -->
    <dimen name="mytube_rail_divider_start">76dp</dimen>
    <dimen name="mytube_rail_divider_gap">6dp</dimen>
    <dimen name="mytube_search_pill_radius">22dp</dimen>
    <dimen name="mytube_search_pill_width">360dp</dimen>
    <dimen name="mytube_search_pill_height">44dp</dimen>
    <!-- 8 + 12 + 28 + 26 = 74dp: labels start just past the 72dp rail -->
    <dimen name="mytube_rail_label_gap">26dp</dimen>
    <!-- No zoom on the focused sidebar item (pill highlight instead) -->
    <item name="lb_browse_header_select_scale" format="float" type="dimen">1.0</item>
    <dimen name="mytube_content_padding_start">24dp</dimen>
    <!-- Flat sidebar: no elevation shadow when it overlays content -->
    <dimen name="lb_browse_headers_z">0dp</dimen>

    <!-- MyTube Home: chips row + 4-column grid -->
    <dimen name="mytube_content_padding_end">48dp</dimen>
    <dimen name="mytube_chips_margin_top">88dp</dimen>
    <dimen name="mytube_chip_text_size">17sp</dimen>
    <dimen name="mytube_chip_padding_h">18dp</dimen>
    <dimen name="mytube_chip_padding_v">8dp</dimen>
    <dimen name="mytube_chip_spacing">12dp</dimen>
    <dimen name="mytube_chips_height">44dp</dimen>
    <dimen name="mytube_chips_grid_gap">20dp</dimen>
</resources>
